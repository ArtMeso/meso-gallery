# Sanity — project is already provisioned at manage.sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=jncu3emy
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Only required for the seed script (npm run seed:artists) and for reading
# draft/unpublished content. Create one at manage.sanity.io -> API -> Tokens
# (Editor role). Never commit a real token — this file is just a template.
SANITY_API_TOKEN=

# Google Sheets artworks catalogue, exported as TSV. The sheet must stay
# shared as "Anyone with the link can view" for this URL to work.
NEXT_PUBLIC_ARTWORKS_SHEET_URL=https://docs.google.com/spreadsheets/d/11bu_TDQ089C_O46hWMEdByBdXmufJCpe93k0Yas9IpY/export?format=tsv&gid=0

# Google Analytics 4 measurement ID (Admin -> Data Streams -> your web stream)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
